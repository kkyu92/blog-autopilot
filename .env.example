# Authentication (leave empty to disable auth in local dev)
AUTH_TOKEN=

# Claude API
ANTHROPIC_API_KEY=

# Blogger OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/blogger/callback

# Naver OAuth (Naver Developers)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3000/api/auth/naver/callback

# Google Custom Search (optional, for research feature)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Image Search (optional)
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Medium (optional — get token from medium.com/me/settings)
# Set via settings page: medium_token
# MEDIUM_INTEGRATION_TOKEN=

# Substack (optional — set via settings page)
# substack_subdomain, substack_email, substack_password

# Database path (optional, default: ./data/content.db)
# DATABASE_PATH=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
